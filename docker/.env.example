# Game server
MGS_ALLOWED_ORIGINS=https://game.trebuchet.network
MGS_DISABLE_STUN=0
MGS_TARGET_BOT_COUNT=0
MGS_MAX_PLAYERS=200
MGS_REQUIRE_AUTH=1
RUST_LOG=massive_game_server_core=info,warp=warn,webrtc=warn
RUST_LOG_JSON=true

# Optional provider integrations
OPENROUTER_API_KEY_SECRET_FILE=./secrets/openrouter_api_key

# Grafana
GRAFANA_ADMIN_USER_SECRET_FILE=./secrets/grafana_admin_user
GRAFANA_ADMIN_PASSWORD_SECRET_FILE=./secrets/grafana_admin_password
GRAFANA_ROOT_URL=https://game.trebuchet.network/grafana
